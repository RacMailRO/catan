{
  "name": "catan-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Catan Strategy Game, AI Research Platform & Deterministic Replay System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@catan/web run dev",
    "dev:server": "npm --workspace=@catan/server run dev",
    "dev:web": "npm --workspace=@catan/web run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/generate-version.mjs && npm run build --workspaces --if-present && node scripts/generate-version.mjs",
    "simulate": "npm --workspace=@catan/server run simulate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
